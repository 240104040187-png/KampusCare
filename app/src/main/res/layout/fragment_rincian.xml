<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Widget.KampusCare.Title"
            android:text="@string/judul_rincian" />

        <TextView
            android:id="@+id/tvStatusRincian"
            style="@style/Widget.KampusCare.Body"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/kc_surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/kc_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRincianKategori"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_teal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/kc_teal_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRincianId"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/kc_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRincianJudul"
                    style="@style/Widget.KampusCare.Title"
                    android:layout_marginTop="12dp"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvRincianLokasi"
                    style="@style/Widget.KampusCare.Body"
                    android:layout_marginTop="8dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRincianWaktu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/kc_muted"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/kc_border" />

                <TextView
                    android:id="@+id/tvRincianDeskripsi"
                    style="@style/Widget.KampusCare.Body"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_badge_teal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/status_lokal"
                    android:textColor="@color/kc_teal_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnUbahRincian"
            style="@style/Widget.KampusCare.PrimaryButton"
            android:layout_marginTop="16dp"
            android:text="@string/ubah_catatan" />

        <Button
            android:id="@+id/btnHapusRincian"
            style="@style/Widget.KampusCare.DangerButton"
            android:layout_marginTop="8dp"
            android:text="@string/hapus_catatan" />

        <Button
            android:id="@+id/btnKembaliRincian"
            style="@style/Widget.KampusCare.OutlinedButton"
            android:layout_marginTop="8dp"
            android:text="@string/kembali" />
    </LinearLayout>
</ScrollView>
