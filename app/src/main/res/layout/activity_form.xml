<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/formRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kc_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvJudulForm"
            style="@style/Widget.KampusCare.Title"
            android:text="@string/judul_form_tambah" />

        <TextView
            android:id="@+id/tvPetunjukForm"
            style="@style/Widget.KampusCare.Body"
            android:layout_marginTop="4dp"
            android:text="@string/info_form_tambah" />

        <TextView
            style="@style/Widget.KampusCare.FieldLabel"
            android:labelFor="@id/etJudul"
            android:text="@string/label_judul" />

        <EditText
            android:id="@+id/etJudul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_box"
            android:hint="@string/hint_judul"
            android:inputType="textCapSentences"
            android:maxLength="100"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp" />

        <TextView
            style="@style/Widget.KampusCare.FieldLabel"
            android:labelFor="@id/spinnerKategori"
            android:text="@string/label_kategori" />

        <Spinner
            android:id="@+id/spinnerKategori"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_box"
            android:entries="@array/kategori_fasilitas"
            android:minHeight="48dp"
            android:paddingHorizontal="8dp" />

        <TextView
            style="@style/Widget.KampusCare.FieldLabel"
            android:labelFor="@id/etLokasi"
            android:text="@string/label_lokasi" />

        <EditText
            android:id="@+id/etLokasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_box"
            android:hint="@string/hint_lokasi"
            android:inputType="textCapSentences"
            android:maxLength="80"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp" />

        <TextView
            style="@style/Widget.KampusCare.FieldLabel"
            android:labelFor="@id/etDeskripsi"
            android:text="@string/label_deskripsi" />

        <EditText
            android:id="@+id/etDeskripsi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_box"
            android:gravity="top"
            android:hint="@string/hint_deskripsi"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500"
            android:minLines="4"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvStatusForm"
            style="@style/Widget.KampusCare.Body"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSimpanForm"
            style="@style/Widget.KampusCare.PrimaryButton"
            android:layout_marginTop="12dp"
            android:text="@string/simpan_perangkat" />

        <Button
            android:id="@+id/btnKembaliForm"
            style="@style/Widget.KampusCare.OutlinedButton"
            android:layout_marginTop="8dp"
            android:text="@string/kembali" />
    </LinearLayout>
</ScrollView>
